{
  "name": "hideouts-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content:fetch": "node scripts/fetch-github.ts",
    "content:render": "node scripts/render-content.ts",
    "content": "npm run content:fetch && npm run content:render",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --quiet",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "check:allowlist": "node scripts/check-allowlist.ts",
    "check:links": "node scripts/check-links.ts",
    "verify": "npm run check:allowlist && npm run check:links"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "beautiful-mermaid": "^1.1.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
