---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import AppCard from '../../components/AppCard.astro';
import { appEntries } from '../../lib/content';

const apps = appEntries();
const counts = {
  all: apps.length,
  iOS: apps.filter((a) => a.platforms.includes('iOS')).length,
};
---

<Base title="Apps" description="Open-source macOS and iOS security and privacy apps: posture scanning, entitlement inspection, iPhone diagnostics, packet capture, and more.">
  <PageHeader
    eyebrow="Applications"
    title="Tools for your Mac and iPhone"
    lead="Native, open-source utilities for inspecting, diagnosing, and protecting Apple devices. Each one documents exactly what it does, and what it doesn’t."
  />
  <section class="container-x pt-10">
    <div data-filter-group="app-grid" hidden class="inline-flex gap-1 rounded-full border border-line bg-surface p-1 text-sm" role="group" aria-label="Filter by platform">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">All <span class="text-ink-3">{counts.all}</span></button>
      <button type="button" data-filter="macOS" aria-pressed="false" class="filter-btn">macOS</button>
      <button type="button" data-filter="iOS" aria-pressed="false" class="filter-btn">iPhone &amp; iPad <span class="text-ink-3">{counts.iOS}</span></button>
    </div>
    <ul id="app-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((e) => <li><AppCard entry={e} /></li>)}
    </ul>
  </section>
</Base>
