---
/** Project logo from the README, or a monogram tile when there isn't one. */
interface Props {
  src: string | null;
  name: string;
  size?: 'sm' | 'lg';
}
const { src, name, size = 'sm' } = Astro.props;
const dim = size === 'lg' ? 'size-20 sm:size-24 rounded-[1.4rem]' : 'size-12 rounded-[0.8rem]';
const initials = name
  .replace(/^The |^Inside /, '')
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

{src ? (
  <img src={src} alt="" width="96" height="96" class={`${dim} shrink-0 border border-line bg-surface-2 object-cover`} />
) : (
  <span
    aria-hidden="true"
    class={`${dim} grid shrink-0 place-items-center border border-line bg-gradient-to-br from-surface-2 to-surface font-mono font-semibold text-accent ${size === 'lg' ? 'text-2xl' : 'text-sm'}`}
  >
    {initials}
  </span>
)}
