---
import type { Entry } from '../lib/content';
import AppIcon from './AppIcon.astro';
import Platforms from './Platforms.astro';
import Icon from './Icon.astro';
interface Props { entry: Entry }
const { entry: e } = Astro.props;
---

<a href={e.href} class="card group flex h-full flex-col p-5" data-platforms={e.platforms.join(' ')}>
  <div class="flex items-start gap-4">
    <AppIcon src={e.gh.logo} name={e.name} />
    <div class="min-w-0">
      <h3 class="font-semibold tracking-tight text-ink">{e.name}</h3>
      <p class="mt-1 text-sm leading-6 text-ink-2">{e.tagline}</p>
    </div>
  </div>
  <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
    <Platforms platforms={e.platforms} />
    {e.gh.language && <span class="chip"><Icon name="code" size={12} />{e.gh.language}</span>}
    {e.gh.release && <span class="chip font-mono">{e.gh.release.tag}</span>}
    <Icon name="arrow-right" size={16} class="ml-auto text-ink-3 transition-transform group-hover:translate-x-0.5 group-hover:text-accent" />
  </div>
</a>
